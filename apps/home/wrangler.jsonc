{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vrtor",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "workers_dev": false, // vrtor.io is the only public host
  "routes": [
    { "pattern": "vrtor.io", "custom_domain": true },
    { "pattern": "www.vrtor.io", "custom_domain": true }
  ],
  // Subjects built in this repo, served at vrtor.io/<code>/ (see src/subjects.js).
  "services": [
    { "binding": "SPC", "service": "vrtor-spc" },
    { "binding": "TAJ", "service": "vrtor-taj" },
    { "binding": "MPC", "service": "vrtor-mpc" },
    { "binding": "APO", "service": "vrtor-apo" },
    { "binding": "FLY", "service": "vrtor-fly" },
    { "binding": "ORCA", "service": "vrtor-orca" },
    { "binding": "GEO", "service": "vrtor-geo" },
    { "binding": "JUMP", "service": "vrtor-jump" },
    { "binding": "CYB", "service": "vrtor-cyb" },
    { "binding": "SND", "service": "vrtor-snd" },
    { "binding": "RDS", "service": "vrtor-rds" },
    { "binding": "BDY", "service": "vrtor-bdy" },
    { "binding": "AIF", "service": "vrtor-aif" },
    { "binding": "CEL", "service": "vrtor-cel" },
    { "binding": "HRT", "service": "vrtor-hrt" },
    { "binding": "MONA", "service": "vrtor-mona" },
    { "binding": "SACRE", "service": "vrtor-sacre" },
    { "binding": "GIZA", "service": "vrtor-giza" }
  ],
  // Live presence and voice for the subjects (src/presence.js). Set either to "off" to switch it off.
  // BREVO_LIST_ID: the "vrtor waitlist" list (folder vrtor). BREVO_API_KEY is a secret: wrangler secret put BREVO_API_KEY
  // WELCOME_FROM: sender of the welcome email (src/welcome-email.js); empty means no welcome email.
  // Replies reach it too: Cloudflare Email Routing forwards all @vrtor.io mail to David's Gmail.
  "vars": { "PRESENCE": "on", "VOICE": "on", "BREVO_LIST_ID": "23", "WELCOME_FROM": "hello@vrtor.io" },
  "durable_objects": {
    "bindings": [{ "name": "PRESENCE_ROOM", "class_name": "PresenceRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PresenceRoom"] }],
  "kv_namespaces": [
    { "binding": "WAITLIST", "id": "1873fda3120a49cd9d44e76b1c048575" }
  ],
  "observability": { "enabled": true }
}
