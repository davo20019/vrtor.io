{
  "name": "vrtor",
  "private": true,
  "description": "Free WebXR learning experiences, one per subject, that open in a headset browser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davo20019/vrtor.io.git"
  },
  "homepage": "https://vrtor.io",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/each.js build",
    "deploy": "node scripts/each.js deploy",
    "test": "npm test --workspaces --if-present",
    "test:snd": "npm run test -w @vrtor/snd"
  },
  "devDependencies": {
    "wrangler": "^4.145.0"
  }
}
